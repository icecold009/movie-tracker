# Flask session signing key. Use a long random value in local and production environments.
SECRET_KEY=replace-with-a-long-random-secret

# Single-admin password used by the current Flask session flow.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# PostgreSQL connection string. For Vercel, use the Supabase Shared Pooler
# transaction-mode URL (port 6543) from the project's Connect settings.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# TMDB API key used only by the Flask server-side search integration.
TMDB_API_KEY=replace-with-your-tmdb-api-key
